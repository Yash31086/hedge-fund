<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BLACKBUSER | Access Portal</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-body">
    <div class="auth-card">
      <div class="auth-header">
        <a class="brand" href="/">BLACKBUSER</a>
        <p>Controlled access for investors and administrators.</p>
      </div>

      <% if (message) { %>
        <div class="message"><%= message %></div>
      <% } %>

      <% if (mode === 'login') { %>
        <div class="auth-toggle" role="tablist" aria-label="Sign in method">
          <button class="auth-toggle-btn active" type="button" data-target="password-panel">Password</button>
          <button class="auth-toggle-btn" type="button" data-target="otp-panel">OTP</button>
        </div>

        <div id="password-panel" class="auth-mode-panel active">
          <form action="/login" method="POST">
            <input type="hidden" name="method" value="password" />
            <h2>Sign in with password</h2>
            <input type="email" name="email" placeholder="Email" value="<%= email %>" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Enter Dashboard</button>
          </form>
        </div>

        <div id="otp-panel" class="auth-mode-panel">
          <form action="/send-login-otp" method="POST">
            <h2>Sign in with OTP</h2>
            <input type="email" name="email" placeholder="Registered email" value="<%= otpEmail || email %>" required />
            <button type="submit">Send one-time code</button>
          </form>

          <form action="/verify-login-otp" method="POST" class="otp-verify-form">
            <input type="email" name="email" placeholder="Registered email" value="<%= otpEmail || email %>" required />
            <input type="text" name="otp" placeholder="6-digit OTP" maxlength="6" required />
            <button type="submit">Verify & enter</button>
          </form>
        </div>

        <div class="auth-links">
          <a href="/register">Create account</a>
          <a href="/forgot">Forgot password</a>
        </div>
      <% } else if (mode === 'register') { %>
        <form action="/register" method="POST">
          <h2>Create account</h2>
          <input type="text" name="name" placeholder="Full name" required />
          <input type="email" name="email" placeholder="Email" required />
          <input type="password" name="password" placeholder="Password" required />
          <button type="submit">Send OTP</button>
        </form>
      <% } else if (mode === 'verify') { %>
        <form action="/verify" method="POST">
          <h2>Verify account</h2>
          <input type="email" name="email" value="<%= email %>" required />
          <input type="text" name="otp" placeholder="6-digit OTP" maxlength="6" required />
          <button type="submit">Confirm</button>
        </form>
      <% } else if (mode === 'forgot') { %>
        <form action="/forgot" method="POST">
          <h2>Recover access</h2>
          <input type="email" name="email" placeholder="Registered email" required />
          <button type="submit">Send reset OTP</button>
        </form>
      <% } else if (mode === 'reset') { %>
        <form action="/reset" method="POST">
          <h2>Set new password</h2>
          <input type="email" name="email" value="<%= email %>" required />
          <input type="text" name="otp" placeholder="6-digit OTP" maxlength="6" required />
          <input type="password" name="password" placeholder="New password" required />
          <button type="submit">Reset password</button>
        </form>
      <% } %>
    </div>

    <script>
      const toggleButtons = document.querySelectorAll('.auth-toggle-btn');
      const panels = document.querySelectorAll('.auth-mode-panel');

      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          toggleButtons.forEach((btn) => btn.classList.toggle('active', btn === button));
          const target = button.getAttribute('data-target');
          panels.forEach((panel) => panel.classList.toggle('active', panel.id === target));
        });
      });
    </script>
  </body>
</html>
