<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BLACKBUSER | Private Quant Fund</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>
    <header class="topbar">
      <a class="brand" href="/">BLACKBUSER</a>
      <nav>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
        <a href="/dashboard">Dashboard</a>
      </nav>
    </header>

    <main class="hero-shell">
      <section class="hero-card">
        <div class="hero-copy">
          <p class="eyebrow">Private Quantitative Investment Fund</p>
          <h1>BLACKBUSER</h1>
          <p class="hero-text">
            Experience transparent portfolio tracking powered by quantitative trading strategies. Monitor your investments, portfolio performance, and returns in real time.
          </p>
          <div class="hero-actions">
            <a class="btn btn-gold" href="/login">Login</a>
            <a class="btn btn-dark" href="/register">Register</a>
            <a class="btn btn-dark" href="#contact">Contact</a>
          </div>
          <div class="hero-metrics">
            <div>
              <strong>$42.8B</strong>
              <span>Assets under guidance</span>
            </div>
            <div>
              <strong>24/7</strong>
              <span>Portfolio intelligence</span>
            </div>
            <div>
              <strong>98.4%</strong>
              <span>Investor confidence</span>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="ticker-card">
            <div class="title-row">
              <span class="live-pill">LIVE</span>
              <span class="muted">NIFTY 50 • SENSEX • NASDAQ</span>
            </div>
            <div class="tickers">
              <div>NASDAQ +0.81%</div>
              <div>DOW +0.24%</div>
              <div>GOLD +0.18%</div>
              <div>BTC +2.03%</div>
            </div>
            <div class="chart">
              <div class="bar b1"></div>
              <div class="bar b2"></div>
              <div class="bar b3"></div>
              <div class="bar b4"></div>
              <div class="bar b5"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="feature-grid">
        <article class="feature-card">
          <h3>Institutional-grade analytics</h3>
          <p>Daily, weekly, monthly, and annual views layered with risk metrics and drawdown intelligence.</p>
        </article>
        <article class="feature-card">
          <h3>Secure investor access</h3>
          <p>JWT-backed sessions, protected routes, and email-based verification designed for private capital.</p>
        </article>
        <article class="feature-card">
          <h3>Premium reporting</h3>
          <p>Generate polished reports for allocations, charges, P&L, and portfolio health in one click.</p>
        </article>
      </section>
    </main>

    <footer id="contact" class="footer">
      <p>BLACKBUSER • Private Capital. Discretionary Intelligence.</p>
    </footer>
  </body>
</html>
