<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BLACKBUSER | Investor Dashboard</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="dash-body">
    <div class="dash-shell">
      <aside class="side-panel">
        <div class="brand-block">
          <h2>BLACKBUSER</h2>
          <p><%= data.user.role === 'super_admin' ? 'Super Admin' : 'Investor Portal' %></p>
        </div>
        <div class="profile-card">
          <h3><%= data.user.name %></h3>
          <p><%= data.user.email %></p>
          <span class="status-badge"><%= data.marketStatus %></span>
        </div>
        <nav class="side-nav">
          <a href="/dashboard">Overview</a>
          <a href="/logout">Logout</a>
        </nav>
      </aside>

      <main class="dash-main">
        <header class="dash-header">
          <div>
            <p class="eyebrow">Institutional Investor Workspace</p>
            <h1><%= data.user.role === 'super_admin' ? 'Admin Command Center' : 'Investor Dashboard' %></h1>
          </div>
          <div class="timestamp"><%= nowLabel() %></div>
        </header>

        <section class="profile-grid">
          <article class="panel-card">
            <div class="panel-title">
              <h3>Investor profile</h3>
              <span class="score"><%= data.user.accountStatus %></span>
            </div>
            <div class="profile-list">
              <div><span>Investor ID</span><strong><%= data.user.investorId %></strong></div>
              <div><span>Account Type</span><strong><%= data.user.accountType %></strong></div>
              <div><span>KYC Status</span><strong><%= data.user.kycStatus %></strong></div>
              <div><span>Risk Profile</span><strong><%= data.user.riskProfile %></strong></div>
              <div><span>Portfolio Manager</span><strong><%= data.user.portfolioManager %></strong></div>
              <div><span>Client Since</span><strong><%= data.user.clientSince %></strong></div>
            </div>
          </article>
          <article class="panel-card">
            <div class="panel-title">
              <h3>Portfolio summary</h3>
              <span class="score"><%= pct(data.user.overallReturnAfterCharges) %></span>
            </div>
            <div class="summary-list">
              <div><span>Total Capital Invested</span><strong><%= currency(data.user.capitalInvested) %></strong></div>
              <div><span>Gross Portfolio Value</span><strong><%= currency(data.user.currentPortfolioValue) %></strong></div>
              <div><span>Net Portfolio Value</span><strong><%= currency(data.user.netPortfolioValue) %></strong></div>
              <div><span>Net Profit After Charges</span><strong><%= currency(data.user.netProfitAfterCharges) %></strong></div>
              <div><span>Overall Return After Charges</span><strong><%= pct(data.user.overallReturnAfterCharges) %></strong></div>
              <div><span>Holding Period</span><strong><%= data.user.holdingPeriod %></strong></div>
            </div>
          </article>
        </section>

        <section class="stats-grid">
          <article class="metric-card">
            <span>Total Invested</span>
            <strong><%= currency(data.user.capitalInvested) %></strong>
          </article>
          <article class="metric-card">
            <span>Portfolio Value</span>
            <strong><%= currency(data.user.currentPortfolioValue) %></strong>
          </article>
          <article class="metric-card">
            <span>Unrealized Profit</span>
            <strong><%= currency(data.user.unrealizedProfit) %></strong>
          </article>
          <article class="metric-card">
            <span>Net Profit</span>
            <strong><%= currency(data.user.netProfitAfterCharges) %></strong>
          </article>
          <article class="metric-card">
            <span>Overall Return</span>
            <strong><%= pct(data.user.overallReturn) %></strong>
          </article>
          <article class="metric-card">
            <span>Health Score</span>
            <strong><%= data.user.healthScore %>/100</strong>
          </article>
        </section>

        <section class="panel-grid">
          <article class="panel-card">
            <div class="panel-title">
              <h3>Portfolio health</h3>
              <span class="score"><%= data.user.healthScore %>/100</span>
            </div>
            <p>Capital deployment remains diversified with disciplined exposure to technology and financial sectors.</p>
            <div class="bar-track"><div class="bar-fill" style="width: <%= data.user.healthScore %>%;"></div></div>
          </article>

          <article class="panel-card">
            <div class="panel-title">
              <h3>Live market mode</h3>
              <span class="live-pill">LIVE</span>
            </div>
            <p>Active trading hours are detected automatically. Portfolio values refresh continuously while the market is open.</p>
            <ul>
              <% data.insights.forEach((item) => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          </article>
        </section>

        <section class="panel-grid">
          <article class="panel-card wide">
            <div class="panel-title">
              <h3>Investment history</h3>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Investment</th>
                  <th>Current Value</th>
                  <th>Profit</th>
                  <th>Return</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% data.user.history.forEach((item) => { %>
                  <tr>
                    <td><%= item.date %></td>
                    <td><%= currency(item.investment) %></td>
                    <td><%= currency(item.currentValue) %></td>
                    <td><%= currency(item.profit) %></td>
                    <td><%= pct(item.returnPct) %></td>
                    <td><%= item.status %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </article>
        </section>

        <section class="panel-grid">
          <article class="panel-card">
            <div class="panel-title">
              <h3>Charges breakdown</h3>
            </div>
            <ul class="charge-list">
              <li>Brokerage: <span><%= currency(data.user.charges.brokerage) %></span></li>
              <li>STT: <span><%= currency(data.user.charges.stt) %></span></li>
              <li>Exchange Transaction Charges: <span><%= currency(data.user.charges.exchangeCharges) %></span></li>
              <li>SEBI Turnover Charges: <span><%= currency(data.user.charges.sebiCharges) %></span></li>
              <li>Stamp Duty: <span><%= currency(data.user.charges.stampDuty) %></span></li>
              <li>GST: <span><%= currency(data.user.charges.gst) %></span></li>
              <li>Platform Maintenance Fee: <span><%= currency(data.user.charges.platformFee) %></span></li>
              <li>AWS Infrastructure Allocation: <span><%= currency(data.user.charges.awsCost) %></span></li>
              <li class="highlight">Total Charges: <span><%= currency(data.user.totalCharges) %></span></li>
            </ul>
          </article>

          <article class="panel-card">
            <div class="panel-title">
              <h3>Open positions</h3>
            </div>
            <ul class="holdings-list">
              <% data.user.holdings.forEach((item) => { %>
                <li>
                  <div>
                    <strong><%= item.symbol %></strong>
                    <span><%= item.qty %> shares</span>
                  </div>
                  <div>
                    <strong><%= currency(item.price) %></strong>
                    <span><%= currency(item.pnl) %></span>
                  </div>
                </li>
              <% }) %>
            </ul>
          </article>
        </section>

        <% if (data.user.role === 'super_admin') { %>
          <section class="panel-card admin-panel">
            <div class="panel-title">
              <h3>Investor administration</h3>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Portfolio</th>
                  <th>Profit</th>
                </tr>
              </thead>
              <tbody>
                <% data.investors.forEach((investor) => { %>
                  <tr>
                    <td><%= investor.name %></td>
                    <td><%= investor.email %></td>
                    <td><%= investor.role %></td>
                    <td><%= currency(investor.portfolio) %></td>
                    <td><%= currency(investor.profit) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </section>
        <% } %>
      </main>
    </div>
  </body>
</html>
